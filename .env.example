# Copy this file to .env and fill in real values. Never commit .env itself.
# Then load it into your shell before opening VS Code — see SETUP.md step 3.

# Razorpay TEST MODE keys — dashboard.razorpay.com -> Settings -> API Keys -> Test Mode
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Derived, not typed by hand: base64("$RAZORPAY_KEY_ID:$RAZORPAY_KEY_SECRET")
# Generate with:  echo -n "$RAZORPAY_KEY_ID:$RAZORPAY_KEY_SECRET" | base64
# (PowerShell:  [Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes("$env:RAZORPAY_KEY_ID`:$env:RAZORPAY_KEY_SECRET")) )
RAZORPAY_MCP_TOKEN=

# console.anthropic.com -> API keys (used by the classifier)
ANTHROPIC_API_KEY=

# context7.com dashboard -> API key. Optional — raises the free rate limit. Leave blank to try without one first.
CONTEXT7_API_KEY=

# GitHub Personal Access Token, repo scope — only needed if you wire up the github MCP server
GITHUB_PAT=

# Local dev database. Left blank on purpose: a relative sqlite:///./data/recoup.db
# resolves against whatever directory the process was launched from — repo root vs
# backend/ (CLAUDE.md's own documented `cd backend && uvicorn ...`) land in two
# different files. backend/app/db.py's default already computes an absolute path to
# the repo-root data/recoup.db regardless of cwd; only override this if you deliberately
# want a different location.
DATABASE_URL=
