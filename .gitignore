# Day 4 model-provider disk cache -- real, gitignored responses, not committed data.
# NOT a wildcard on data/*.json: backend/data/harvested_corpus.json and the committed
# playbook_*.json files are real, tracked data and must stay tracked.
backend/data/model_cache/

# playwright MCP screenshots/snapshots -- session-local verification artifacts, not deliverables
.playwright-mcp/

# os / editor
.DS_Store
.vscode/*
!.vscode/extensions.json

# local Claude Code settings -- per-machine (which MCP servers are enabled locally),
# not project config; a committed copy of this reads as carelessness, not intent.
# .claude/commands/ (the project's own slash commands) stays tracked.
.claude/settings.local.json
